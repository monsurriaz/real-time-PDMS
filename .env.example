# ============================================
#  Copy to .env and fill in:  cp .env.example .env
#
#  THIS FILE IS COMMITTED TO GIT. Keys only, never values.
#  Real values go in .env, which is gitignored.
# ============================================

# ---- server ----
NODE_ENV=development
# 5001, not 5000: macOS AirPlay Receiver (ControlCenter) already listens
# on 5000, which makes the server fail with EADDRINUSE.
PORT=5001
CLIENT_ORIGIN=http://localhost:5173

# ---- delivery lifecycle (M8) ----
# How long a rider has to Accept/Decline an offered delivery before it
# expires and returns to the pool. Evaluated on read, not a scheduled job.
# Minutes; decimals allowed. Set to e.g. 1 to demo a ~60s expiry, then
# restart the server. Defaults to 60 (one hour) if unset.
OFFER_WINDOW_MINUTES=60

# ---- database ----
# MongoDB Atlas → Connect → Drivers → copy the string, replace <password>
# Shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parcel-delivery?retryWrites=true&w=majority
MONGODB_URI=

# ---- auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# ---- maps ----
# Tiles need no key. This is the OpenFreeMap style URL.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Nominatim requires a real contact string. Free, but they block anonymous abuse.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ParcelDelivery/1.0 (your.email@example.com)

# OpenRouteService → Dashboard → Request a token (free)
ORS_API_KEY=

# ---- media (proof of delivery) ----
# The rider's phone uploads the photo DIRECTLY to Cloudinary with an unsigned
# preset, so the browser needs the cloud name and preset (hence VITE_), and the
# server needs only the cloud name -- to check that a submitted URL belongs to
# this cloud. No API key or secret is used anywhere: an unsigned preset does not
# need one, and a secret in the browser would not be a secret.
#   Cloudinary -> Settings -> Upload -> Add upload preset -> Signing mode:
#   Unsigned. Note the preset name.
CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- payments (test mode only) ----
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# ---- client ----
VITE_API_BASE_URL=http://localhost:5001
VITE_SOCKET_URL=http://localhost:5001

# The login screen's seeded-account panel — on by default (this IS the
# course demo), set to false only for a real deploy where it shouldn't show.
VITE_SHOW_DEMO_LOGINS=true
